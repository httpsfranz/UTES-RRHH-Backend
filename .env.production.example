# Plantilla para producción. Copiar a .env en el servidor y completar lo vacío; no versionar el .env real.
APP_NAME="UTES RRHH"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://
FRONTEND_URL=https://

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=DB_ControlAsistencia
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Correo de avisos: sin SMTP real no llegan las notificaciones por correo.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Token nuevo: el anterior quedó en el historial de git.
DECOLECTA_TOKEN=

RESPALDO_DIRECTORIO=
RESPALDO_DIAS=30

# Se apaga solo mientras se carga información histórica.
RIT_CONTROL_DE_PLAZOS=true
